APP_NAME=Fabudge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://budget.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# SQLite lives in shared/ so it survives release swaps.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/fabudge/shared/database/database.sqlite
# The web process, queue worker and scheduler all write. WAL lets readers run
# during a write; busy_timeout makes writers wait rather than fail outright.
DB_JOURNAL_MODE=WAL
DB_BUSY_TIMEOUT=5000
DB_SYNCHRONOUS=NORMAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless you serve subdomains; a wrong value silently breaks login.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fortify sends verification, password reset and team invitation mail. Without
# working mail, new users cannot verify and invitations silently vanish.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="budget@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Voice dictation calls Claude. Leave blank to disable the feature; it is the
# only outbound paid dependency in the app.
ANTHROPIC_API_KEY=

VITE_APP_NAME="${APP_NAME}"
